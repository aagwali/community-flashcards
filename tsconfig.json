{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,

    /* Strictness. Non négociable : le domaine doit être indiscutable. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,

    /* "node" sert au fichier de configuration Vite et à la validation du contenu,
       qui lit les fichiers depuis le disque. Le code applicatif n'y touche pas. */
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts", "eslint.config.js"]
}
